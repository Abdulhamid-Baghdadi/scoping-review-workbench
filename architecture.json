{
  "format": "design-rules architecture",
  "version": 1,
  "name": "Scoping Review Workbench",
  "about": "The layers of ARCHITECTURE.md, bottom first, as the design rules' check_layers.py holds them. Domain, ports and services import no platform module or package, so they run in the browser as they are; the page imports only the packages of web/index.html's import map.",
  "reader": "es-modules",
  "sources": ["src/**/*.js", "web/**/*.js", "!web/sw.js", "!web/install.js"],
  "layers": [
    {"name": "domain", "files": ["src/domain/**/*.js"], "uses": [], "packages": []},
    {"name": "ports", "files": ["src/ports/**/*.js"], "uses": ["domain"], "packages": []},
    {"name": "services", "files": ["src/services/**/*.js"], "uses": ["domain", "ports"], "packages": []},
    {"name": "adapters", "files": ["src/adapters/**/*.js"], "uses": ["domain", "ports"]},
    {"name": "public API", "files": ["src/index.js"], "uses": ["domain", "ports", "services", "adapters"]},
    {"name": "engine ui", "files": ["src/ui/**/*.js"], "uses": ["public API", "adapters"]},
    {"name": "art", "files": ["web/art/**/*.js"], "uses": [], "packages": []},
    {"name": "studio core", "files": ["web/studio/core/**/*.js"], "uses": [], "packages": ["pdfjs", "pdfjs/worker"]},
    {"name": "studio ui", "files": ["web/studio/ui/**/*.js"], "uses": ["studio core", "art"], "packages": ["pdfjs", "pdfjs/worker"]},
    {"name": "studio shell", "files": ["web/studio/shell/**/*.js"], "uses": ["studio ui", "studio core"], "packages": ["pdfjs", "pdfjs/worker"]},
    {"name": "studio pages", "files": ["web/studio/pages/**/*.js"], "uses": ["studio shell", "studio ui", "studio core"], "packages": ["pdfjs", "pdfjs/worker"]},
    {"name": "studio app", "files": ["web/studio/*.js"], "uses": ["studio pages", "studio shell", "studio ui", "studio core"], "packages": ["pdfjs", "pdfjs/worker"]},
    {"name": "boot", "files": ["web/*.js", "web/start/**/*.js", "!web/sw.js", "!web/install.js"], "uses": ["public API", "engine ui", "art", "studio app"], "packages": ["pdfjs", "pdfjs/worker"]}
  ],
  "allow": []
}
